diff --git a/internal/storage/governance_gate.go b/internal/storage/governance_gate.go
new file mode 100644
index 0000000..4585753
--- /dev/null
+++ b/internal/storage/governance_gate.go
@@ -0,0 +1,133 @@
+package storage
+
+// The enforcement gate: a pure read decision over the governance state. For a
+// governed method the gate derives the request packet's own key (the first
+// eight hex characters of the packet digest) and reads what the approvals
+// table holds for that key. It never writes: an ask is opened by the caller
+// through RequestApproval, not by the evaluation itself, so the same packet
+// always evaluates to the same decision and the evaluator cannot move the
+// state it judges.
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"sort"
+	"strings"
+)
+
+// Gate actions. allow proceeds, ask means the caller must open (or wait on)
+// the approval keyed by Decision.Key, deny refuses the call outright.
+const (
+	GateAllow = "allow"
+	GateAsk   = "ask"
+	GateDeny  = "deny"
+)
+
+// governedMethods is the registry of methods the gate judges. The list grows
+// only by a documented decision; everything outside it passes untouched.
+var governedMethods = map[string]bool{
+	"remember":         true,
+	"save_cap":         true,
+	"governance_decide": true,
+	"broadcast":        true,
+}
+
+// GovernedMethods reports the governed registry (for the handler wiring and
+// the tests).
+func GovernedMethods() []string {
+	out := make([]string, 0, len(governedMethods))
+	for m := range governedMethods {
+		out = append(out, m)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// IsGovernedMethod reports whether the gate judges this method.
+func IsGovernedMethod(method string) bool {
+	return governedMethods[method]
+}
+
+// GateKey derives the request packet's governance key: the first eight hex
+// characters of the digest over the method and its canonical parameters. The
+// same packet always hashes to the same ask, and a packet that differs in any
+// parameter hashes to a different one — the key is the packet's own identity,
+// not a counter.
+func GateKey(method string, params map[string]any) string {
+	h := sha256.New()
+	h.Write([]byte(method))
+	h.Write([]byte{0})
+	h.Write([]byte(canonicalParamsJSON(params)))
+	return hex.EncodeToString(h.Sum(nil))[:8]
+}
+
+// canonicalParamsJSON renders the params deterministically: keys sorted,
+// values JSON-encoded, so map iteration order cannot move the digest.
+func canonicalParamsJSON(params map[string]any) string {
+	if len(params) == 0 {
+		return "{}"
+	}
+	keys := make([]string, 0, len(params))
+	for k := range params {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	var b strings.Builder
+	b.WriteByte('{')
+	for i, k := range keys {
+		if i > 0 {
+			b.WriteByte(',')
+		}
+		kj, _ := json.Marshal(k)
+		vj, _ := json.Marshal(params[k])
+		b.Write(kj)
+		b.WriteByte(':')
+		b.Write(vj)
+	}
+	b.WriteByte('}')
+	return b.String()
+}
+
+// GateDecision is the evaluation's outcome.
+type GateDecision struct {
+	Action     string `json:"action"`
+	Key        string `json:"key"`
+	ApprovalID int64  `json:"approval_id"`
+	Reason     string `json:"reason"`
+}
+
+// EvaluateGovernance judges one request. Governed methods read their packet's
+// approval row: no row means the caller owes an ask, an open row means the ask
+// still waits, a deny decision refuses, and an allow decision is the standing
+// grant that admits the packet. Ungoverned methods pass with no read at all.
+func (s *Store) EvaluateGovernance(method, caller, surface string, params map[string]any) GateDecision {
+	key := GateKey(method, params)
+	if !IsGovernedMethod(method) {
+		return GateDecision{Action: GateAllow, Key: key, Reason: "method is not governed"}
+	}
+	row, err := s.ApprovalForKey(key)
+	if err != nil {
+		return GateDecision{Action: GateDeny, Key: key,
+			Reason: fmt.Sprintf("governance read failed: %v", err)}
+	}
+	if row == nil {
+		return GateDecision{Action: GateAsk, Key: key,
+			Reason: fmt.Sprintf("no approval stands for %s on %s; open the ask keyed %s", method, surface, key)}
+	}
+	switch {
+	case row.Status == ApprovalOpen:
+		return GateDecision{Action: GateAsk, Key: key, ApprovalID: row.ID,
+			Reason: fmt.Sprintf("the ask for %s (%s) is still open; decide it or wait", method, key)}
+	case row.Decision == ApprovalDeny:
+		return GateDecision{Action: GateDeny, Key: key, ApprovalID: row.ID,
+			Reason: fmt.Sprintf("the ask for %s (%s) was denied", method, key)}
+	case row.Decision == ApprovalAllow:
+		return GateDecision{Action: GateAllow, Key: key, ApprovalID: row.ID,
+			Reason: fmt.Sprintf("standing allow for %s (%s)", method, key)}
+	default:
+		return GateDecision{Action: GateDeny, Key: key, ApprovalID: row.ID,
+			Reason: fmt.Sprintf("the ask for %s (%s) is in state %q", method, key, row.Status)}
+	}
+}
diff --git a/internal/storage/governance_gate_test.go b/internal/storage/governance_gate_test.go
new file mode 100644
index 0000000..ee20402
--- /dev/null
+++ b/internal/storage/governance_gate_test.go
@@ -0,0 +1,128 @@
+package storage
+
+// The gate is a pure reader: its decisions come from the rows on disk, its key
+// comes from the packet itself, and evaluating never writes a row. The tests
+// pin the key derivation, the registry, and every decision arm.
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestGateKeyIsThePacketDigest(t *testing.T) {
+	key := GateKey("remember", map[string]any{"project": "/w", "content": "hi"})
+	if len(key) != 8 {
+		t.Fatalf("key = %q, want 8 hex characters", key)
+	}
+	for _, r := range key {
+		if !strings.ContainsRune("0123456789abcdef", r) {
+			t.Fatalf("key %q is not hex", key)
+		}
+	}
+}
+
+func TestGateKeyIsStableForTheSamePacket(t *testing.T) {
+	a := GateKey("remember", map[string]any{"content": "hi", "project": "/w"})
+	b := GateKey("remember", map[string]any{"project": "/w", "content": "hi"})
+	if a != b {
+		t.Errorf("keys %q and %q differ: map order moved the digest", a, b)
+	}
+}
+
+func TestGateKeyMovesWithAnyParameter(t *testing.T) {
+	base := GateKey("remember", map[string]any{"content": "hi"})
+	other := GateKey("remember", map[string]any{"content": "hi!", "x": 1})
+	if base == other {
+		t.Error("a different packet hashed to the same ask")
+	}
+	if GateKey("remember", nil) == GateKey("save_cap", nil) {
+		t.Error("the method did not separate the packets")
+	}
+}
+
+func TestGateRegistryHoldsTheGovernedMethods(t *testing.T) {
+	ms := GovernedMethods()
+	if len(ms) == 0 {
+		t.Fatal("the governed registry is empty")
+	}
+	for _, m := range []string{"remember", "save_cap"} {
+		if !IsGovernedMethod(m) {
+			t.Errorf("%s is not governed", m)
+		}
+	}
+	if IsGovernedMethod("get_learnings") {
+		t.Error("an unlisted read was governed: the gate is default-pass outside the registry")
+	}
+}
+
+func TestGateEvaluateNeverWrites(t *testing.T) {
+	s := mustOpen(t)
+	before, _ := s.OpenApprovalCount()
+	d := s.EvaluateGovernance("remember", "claude", "agent", map[string]any{"content": "hi"})
+	after, _ := s.OpenApprovalCount()
+	if d.Action != GateAsk {
+		t.Fatalf("action = %q, want ask for a packet with no approval", d.Action)
+	}
+	if before != after {
+		t.Errorf("open count moved %d -> %d: the evaluator opened a row", before, after)
+	}
+	if events, _ := s.GovernanceSnapshot(); len(events) != 0 {
+		t.Errorf("the evaluator wrote %d events; it must stay a pure read", len(events))
+	}
+}
+
+func TestGateOpenRowStillAsks(t *testing.T) {
+	s := mustOpen(t)
+	id, _ := s.RequestApproval(GateKey("remember", nil), "remember", "claude", "agent", time.Minute)
+	d := s.EvaluateGovernance("remember", "claude", "agent", nil)
+	if d.Action != GateAsk || d.ApprovalID != id {
+		t.Errorf("decision = %+v, want ask naming the open row %d", d, id)
+	}
+}
+
+func TestGateDenyDecisionRefuses(t *testing.T) {
+	s := mustOpen(t)
+	key := GateKey("remember", nil)
+	_, _ = s.RequestApproval(key, "remember", "claude", "agent", time.Minute)
+	if err := s.DecideApproval(key, ApprovalDeny, "operator"); err != nil {
+		t.Fatalf("decide: %v", err)
+	}
+	d := s.EvaluateGovernance("remember", "claude", "agent", nil)
+	if d.Action != GateDeny {
+		t.Errorf("action = %q, want deny after a deny decision", d.Action)
+	}
+}
+
+func TestGateAllowDecisionIsTheStandingGrant(t *testing.T) {
+	s := mustOpen(t)
+	key := GateKey("remember", nil)
+	_, _ = s.RequestApproval(key, "remember", "claude", "agent", time.Minute)
+	if err := s.DecideApproval(key, ApprovalAllow, "operator"); err != nil {
+		t.Fatalf("decide: %v", err)
+	}
+	d := s.EvaluateGovernance("remember", "claude", "agent", nil)
+	if d.Action != GateAllow {
+		t.Errorf("action = %q, want allow from the standing grant", d.Action)
+	}
+	if d.Key != key {
+		t.Errorf("decision key = %q, want the packet key %q", d.Key, key)
+	}
+}
+
+func TestGateUngovernedMethodPassesUntouched(t *testing.T) {
+	s := mustOpen(t)
+	d := s.EvaluateGovernance("get_learnings", "claude", "agent", nil)
+	if d.Action != GateAllow {
+		t.Errorf("action = %q, want allow for an ungoverned read", d.Action)
+	}
+}
+
+func TestGateReadFailureClosesTheCall(t *testing.T) {
+	s := mustOpen(t)
+	s.Close()
+	d := s.EvaluateGovernance("remember", "claude", "agent", nil)
+	if d.Action != GateDeny {
+		t.Errorf("action = %q, want deny when the governance read fails: fail closed", d.Action)
+	}
+}
