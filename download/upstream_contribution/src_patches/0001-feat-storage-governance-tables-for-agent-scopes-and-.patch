diff --git a/internal/storage/governance.go b/internal/storage/governance.go
new file mode 100644
index 0000000..9bf96ae
--- /dev/null
+++ b/internal/storage/governance.go
@@ -0,0 +1,287 @@
+package storage
+
+// Governance approvals and their audit trail. Nemons governs a small set of
+// memory-touching operations through an explicit approval lifecycle: a caller
+// whose request needs approval opens an ask (keyed by the request packet's
+// digest), the operator decides it, and every transition writes its own event
+// in the same transaction as the row it describes. The write+event pair shares
+// one BEGIN IMMEDIATE transaction (the DeleteDocSource idiom) so a concurrent
+// appender cannot interleave between the row and its event.
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"time"
+)
+
+const (
+	tableGovernanceApprovals = `CREATE TABLE IF NOT EXISTS governance_approvals (
+	id          INTEGER PRIMARY KEY AUTOINCREMENT,
+	key         TEXT NOT NULL UNIQUE,
+	method      TEXT NOT NULL,
+	caller      TEXT NOT NULL DEFAULT '',
+	surface     TEXT NOT NULL DEFAULT 'agent',
+	status      TEXT NOT NULL DEFAULT 'open',
+	decision    TEXT NOT NULL DEFAULT '',
+	requested_at TEXT NOT NULL,
+	decided_at  TEXT,
+	expires_at  TEXT
+)`
+
+	tableGovernanceEvents = `CREATE TABLE IF NOT EXISTS governance_events (
+	id          INTEGER PRIMARY KEY AUTOINCREMENT,
+	kind        TEXT NOT NULL,
+	approval_id INTEGER,
+	key         TEXT NOT NULL DEFAULT '',
+	detail      TEXT NOT NULL DEFAULT '',
+	created_at  TEXT NOT NULL
+)`
+)
+
+// Approval statuses and decisions.
+const (
+	ApprovalOpen    = "open"
+	ApprovalDecided = "decided"
+	ApprovalExpired = "expired"
+
+	ApprovalAllow = "allow"
+	ApprovalDeny  = "deny"
+
+	EventApprovalRequested = "approval.requested"
+	EventApprovalDecided   = "approval.decided"
+	EventApprovalExpired   = "approval.expired"
+)
+
+// GovernanceApproval is one ask row: what was requested, by whom, and where it
+// stands.
+type GovernanceApproval struct {
+	ID         int64
+	Key        string
+	Method     string
+	Caller     string
+	Surface    string
+	Status     string
+	Decision   string
+	RequestedAt string
+	DecidedAt  string
+	ExpiresAt  string
+}
+
+// GovernanceEvent is one audit line in the governance trail.
+type GovernanceEvent struct {
+	ID        int64
+	Kind      string
+	ApprovalID int64
+	Key       string
+	Detail    string
+	CreatedAt string
+}
+
+// ErrApprovalNotOpen reports a decide on a row that is no longer open: the
+// decision landed after a concurrent terminal transition (a decide or an
+// expiry) already closed it, so it is refused instead of being applied twice.
+var ErrApprovalNotOpen = errors.New("governance approval is not open")
+
+// ErrApprovalUnknown reports a decide or read for a key the store never saw.
+var ErrApprovalUnknown = errors.New("governance approval key is unknown")
+
+// nowUTC renders the store's timestamps. UTC keeps the julianday() windows the
+// rest of the store relies on consistent with these rows.
+func nowUTC() string { return time.Now().UTC().Format(time.RFC3339) }
+
+// RequestApproval opens (or finds) the approval ask for key. The ask is
+// idempotent: an already-open row for the same key is returned as it is, with
+// no second row and no second event, so a caller that retries its ask cannot
+// stack open requests behind one another. The row and its approval.requested
+// event share one BEGIN IMMEDIATE transaction.
+func (s *Store) RequestApproval(key, method, caller, surface string, ttl time.Duration) (int64, error) {
+	if key == "" {
+		return 0, errors.New("governance approval key must not be empty")
+	}
+	if method == "" {
+		return 0, errors.New("governance approval method must not be empty")
+	}
+	if surface == "" {
+		surface = "agent"
+	}
+	ctx := context.Background()
+	conn, err := s.db.Conn(ctx)
+	if err != nil {
+		return 0, err
+	}
+	defer conn.Close()
+
+	if _, err := conn.ExecContext(ctx, "BEGIN IMMEDIATE"); err != nil {
+		return 0, err
+	}
+	committed := false
+	defer func() {
+		if !committed {
+			_, _ = conn.ExecContext(ctx, "ROLLBACK")
+		}
+	}()
+
+	var id int64
+	err = conn.QueryRowContext(ctx,
+		`SELECT id FROM governance_approvals WHERE key = ? AND status = ?`, key, ApprovalOpen,
+	).Scan(&id)
+	if err == nil {
+		committed = true
+		if _, err := conn.ExecContext(ctx, "COMMIT"); err != nil {
+			return 0, err
+		}
+		return id, nil
+	}
+	if !errors.Is(err, sql.ErrNoRows) {
+		return 0, err
+	}
+
+	nowT := time.Now().UTC()
+	now := nowT.Format(time.RFC3339)
+	expires := nowT.Add(ttl).Format(time.RFC3339)
+	res, err := conn.ExecContext(ctx,
+		`INSERT INTO governance_approvals (key, method, caller, surface, status, requested_at, expires_at)
+		 VALUES (?, ?, ?, ?, ?, ?, ?)`,
+		key, method, caller, surface, ApprovalOpen, now, expires)
+	if err != nil {
+		return 0, err
+	}
+	id, err = res.LastInsertId()
+	if err != nil {
+		return 0, err
+	}
+	if _, err := conn.ExecContext(ctx,
+		`INSERT INTO governance_events (kind, approval_id, key, detail, created_at)
+		 VALUES (?, ?, ?, ?, ?)`,
+		EventApprovalRequested, id, key, method+" on "+surface, now); err != nil {
+		return 0, err
+	}
+	committed = true
+	if _, err := conn.ExecContext(ctx, "COMMIT"); err != nil {
+		return 0, err
+	}
+	return id, nil
+}
+
+// ApprovalForKey reads the row a key currently names, open or closed. The
+// enforcement gate is a pure reader over these rows: it never opens or closes
+// one, it only looks.
+func (s *Store) ApprovalForKey(key string) (*GovernanceApproval, error) {
+	row := s.db.QueryRow(
+		`SELECT id, key, method, caller, surface, status, decision, requested_at, COALESCE(decided_at, ''), COALESCE(expires_at, '')
+		 FROM governance_approvals WHERE key = ?`, key)
+	var a GovernanceApproval
+	if err := row.Scan(&a.ID, &a.Key, &a.Method, &a.Caller, &a.Surface, &a.Status, &a.Decision,
+		&a.RequestedAt, &a.DecidedAt, &a.ExpiresAt); err != nil {
+		if errors.Is(err, sql.ErrNoRows) {
+			return nil, nil
+		}
+		return nil, err
+	}
+	return &a, nil
+}
+
+// OpenApprovalCount reports how many asks currently wait for a decision.
+func (s *Store) OpenApprovalCount() (int, error) {
+	var n int
+	if err := s.db.QueryRow(
+		`SELECT COUNT(*) FROM governance_approvals WHERE status = ?`, ApprovalOpen,
+	).Scan(&n); err != nil {
+		return 0, err
+	}
+	return n, nil
+}
+
+// DecideApproval closes the open row a key names with decision. The update
+// lands by row id and status together: a decision that arrives after a
+// concurrent terminal transition already closed the row is refused with
+// ErrApprovalNotOpen instead of being applied a second time. The row's
+// decision and its approval.decided event share one transaction.
+func (s *Store) DecideApproval(key, decision, decider string) error {
+	if decision != ApprovalAllow && decision != ApprovalDeny {
+		return errors.New("governance decision must be allow or deny")
+	}
+	ctx := context.Background()
+	conn, err := s.db.Conn(ctx)
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+
+	if _, err := conn.ExecContext(ctx, "BEGIN IMMEDIATE"); err != nil {
+		return err
+	}
+	committed := false
+	defer func() {
+		if !committed {
+			_, _ = conn.ExecContext(ctx, "ROLLBACK")
+		}
+	}()
+
+	var id int64
+	var status string
+	err = conn.QueryRowContext(ctx,
+		`SELECT id, status FROM governance_approvals WHERE key = ?`, key,
+	).Scan(&id, &status)
+	if errors.Is(err, sql.ErrNoRows) {
+		return ErrApprovalUnknown
+	}
+	if err != nil {
+		return err
+	}
+	if status != ApprovalOpen {
+		return ErrApprovalNotOpen
+	}
+	now := nowUTC()
+	res, err := conn.ExecContext(ctx,
+		`UPDATE governance_approvals SET status = ?, decision = ?, decided_at = ? WHERE id = ? AND status = ?`,
+		ApprovalDecided, decision, now, id, ApprovalOpen)
+	if err != nil {
+		return err
+	}
+	if n, _ := res.RowsAffected(); n == 0 {
+		return ErrApprovalNotOpen
+	}
+	if _, err := conn.ExecContext(ctx,
+		`INSERT INTO governance_events (kind, approval_id, key, detail, created_at)
+		 VALUES (?, ?, ?, ?, ?)`,
+		EventApprovalDecided, id, key, decision+" by "+decider, now); err != nil {
+		return err
+	}
+	committed = true
+	_, err = conn.ExecContext(ctx, "COMMIT")
+	return err
+}
+
+// GovernanceEvents reads the audit trail, newest last. A limit of 0 means
+// unlimited.
+func (s *Store) GovernanceEvents(limit int) ([]GovernanceEvent, error) {
+	q := `SELECT id, kind, COALESCE(approval_id, 0), key, detail, created_at
+		 FROM governance_events ORDER BY id`
+	var args []any
+	if limit > 0 {
+		q += " LIMIT ?"
+		args = append(args, limit)
+	}
+	rows, err := s.db.Query(q, args...)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var out []GovernanceEvent
+	for rows.Next() {
+		var e GovernanceEvent
+		if err := rows.Scan(&e.ID, &e.Kind, &e.ApprovalID, &e.Key, &e.Detail, &e.CreatedAt); err != nil {
+			return nil, err
+		}
+		out = append(out, e)
+	}
+	return out, rows.Err()
+}
+
+// GovernanceSnapshot returns the full event sequence the store holds — the
+// picture a snapshot read presents to the operator.
+func (s *Store) GovernanceSnapshot() ([]GovernanceEvent, error) {
+	return s.GovernanceEvents(0)
+}
diff --git a/internal/storage/governance_test.go b/internal/storage/governance_test.go
new file mode 100644
index 0000000..b355a6f
--- /dev/null
+++ b/internal/storage/governance_test.go
@@ -0,0 +1,239 @@
+package storage
+
+// The governance approval lifecycle, its idempotence, and its audit trail.
+// Every state change the store applies to an approval row writes its own event
+// in the same transaction as the row, so the trail can be replayed as the
+// record of what happened.
+
+import (
+	"errors"
+	"testing"
+	"time"
+)
+
+func mustKey(t *testing.T, s string) string {
+	t.Helper()
+	if s == "" {
+		t.Fatal("seed key must not be empty")
+	}
+	return s
+}
+
+func TestGovernanceRequestApprovalOpensOneRow(t *testing.T) {
+	s := mustOpen(t)
+	id, err := s.RequestApproval("abcd1234", "remember", "claude", "agent", time.Minute)
+	if err != nil {
+		t.Fatalf("RequestApproval: %v", err)
+	}
+	a, err := s.ApprovalForKey("abcd1234")
+	if err != nil || a == nil {
+		t.Fatalf("ApprovalForKey: %v, %v", a, err)
+	}
+	if a.ID != id || a.Status != ApprovalOpen || a.Method != "remember" || a.Surface != "agent" {
+		t.Errorf("row = %+v, want the open remember ask on the agent surface", a)
+	}
+}
+
+func TestGovernanceAskIsIdempotentPerKey(t *testing.T) {
+	s := mustOpen(t)
+	first, err := s.RequestApproval("abcd1234", "remember", "claude", "agent", time.Minute)
+	if err != nil {
+		t.Fatalf("first ask: %v", err)
+	}
+	second, err := s.RequestApproval("abcd1234", "remember", "claude", "agent", time.Minute)
+	if err != nil {
+		t.Fatalf("second ask: %v", err)
+	}
+	if first != second {
+		t.Errorf("asks returned %d then %d, want the same open row", first, second)
+	}
+	n, err := s.OpenApprovalCount()
+	if err != nil || n != 1 {
+		t.Errorf("open count = %d (%v), want 1: a retried ask stacks no rows", n, err)
+	}
+}
+
+func TestGovernanceRequestedEventWrittenOncePerKey(t *testing.T) {
+	s := mustOpen(t)
+	_, _ = s.RequestApproval("abcd1234", "remember", "claude", "agent", time.Minute)
+	_, _ = s.RequestApproval("abcd1234", "remember", "claude", "agent", time.Minute)
+	events, err := s.GovernanceSnapshot()
+	if err != nil {
+		t.Fatalf("GovernanceSnapshot: %v", err)
+	}
+	kind := 0
+	for _, e := range events {
+		if e.Kind == EventApprovalRequested && e.Key == "abcd1234" {
+			kind++
+		}
+	}
+	if kind != 1 {
+		t.Errorf("approval.requested events for the key = %d, want 1", kind)
+	}
+}
+
+func TestGovernanceDecideClosesTheOpenRow(t *testing.T) {
+	s := mustOpen(t)
+	_, _ = s.RequestApproval("abcd1234", "remember", "claude", "agent", time.Minute)
+	if err := s.DecideApproval("abcd1234", ApprovalAllow, "operator"); err != nil {
+		t.Fatalf("DecideApproval: %v", err)
+	}
+	a, _ := s.ApprovalForKey("abcd1234")
+	if a.Status != ApprovalDecided || a.Decision != ApprovalAllow {
+		t.Errorf("row = %+v, want a decided allow", a)
+	}
+	if a.DecidedAt == "" {
+		t.Error("decided_at is empty: the close carries its own instant")
+	}
+}
+
+func TestGovernanceDecideRefusedAfterTheRowClosed(t *testing.T) {
+	s := mustOpen(t)
+	_, _ = s.RequestApproval("abcd1234", "remember", "claude", "agent", time.Minute)
+	if err := s.DecideApproval("abcd1234", ApprovalAllow, "operator"); err != nil {
+		t.Fatalf("first decide: %v", err)
+	}
+	if err := s.DecideApproval("abcd1234", ApprovalDeny, "operator"); !errors.Is(err, ErrApprovalNotOpen) {
+		t.Errorf("second decide err = %v, want ErrApprovalNotOpen", err)
+	}
+}
+
+func TestGovernanceDecideRefusedForUnknownKey(t *testing.T) {
+	s := mustOpen(t)
+	if err := s.DecideApproval("deadbeef", ApprovalAllow, "operator"); !errors.Is(err, ErrApprovalUnknown) {
+		t.Errorf("err = %v, want ErrApprovalUnknown", err)
+	}
+}
+
+func TestGovernanceDecisionMustBeAllowOrDeny(t *testing.T) {
+	s := mustOpen(t)
+	_, _ = s.RequestApproval("abcd1234", "remember", "claude", "agent", time.Minute)
+	if err := s.DecideApproval("abcd1234", "maybe", "operator"); err == nil {
+		t.Fatal("a free-text decision was accepted")
+	}
+}
+
+func TestGovernanceDecidedEventCarriesTheDecider(t *testing.T) {
+	s := mustOpen(t)
+	_, _ = s.RequestApproval("abcd1234", "remember", "claude", "agent", time.Minute)
+	if err := s.DecideApproval("abcd1234", ApprovalDeny, "nasser"); err != nil {
+		t.Fatalf("DecideApproval: %v", err)
+	}
+	events, _ := s.GovernanceSnapshot()
+	found := false
+	for _, e := range events {
+		if e.Kind == EventApprovalDecided {
+			found = true
+			if e.ApprovalID == 0 || e.Key != "abcd1234" {
+				t.Errorf("event = %+v, want the approval id and key on it", e)
+			}
+			if e.Detail != "deny by nasser" {
+				t.Errorf("detail = %q, want the decision and the decider", e.Detail)
+			}
+		}
+	}
+	if !found {
+		t.Fatal("no approval.decided event in the trail")
+	}
+}
+
+func TestGovernanceDifferentKeysGetTheirOwnRows(t *testing.T) {
+	s := mustOpen(t)
+	for _, key := range []string{"aaaa1111", "bbbb2222", "cccc3333"} {
+		if _, err := s.RequestApproval(key, "remember", "claude", "agent", time.Minute); err != nil {
+			t.Fatalf("ask %s: %v", key, err)
+		}
+	}
+	n, _ := s.OpenApprovalCount()
+	if n != 3 {
+		t.Errorf("open count = %d, want 3", n)
+	}
+}
+
+func TestGovernanceOpenCountExcludesClosedRows(t *testing.T) {
+	s := mustOpen(t)
+	_, _ = s.RequestApproval("aaaa1111", "remember", "claude", "agent", time.Minute)
+	_, _ = s.RequestApproval("bbbb2222", "remember", "claude", "agent", time.Minute)
+	if err := s.DecideApproval("aaaa1111", ApprovalAllow, "operator"); err != nil {
+		t.Fatalf("decide: %v", err)
+	}
+	n, _ := s.OpenApprovalCount()
+	if n != 1 {
+		t.Errorf("open count = %d, want 1 after one decide", n)
+	}
+}
+
+func TestGovernanceEmptyKeyOrMethodRefused(t *testing.T) {
+	s := mustOpen(t)
+	if _, err := s.RequestApproval("", "remember", "claude", "agent", time.Minute); err == nil {
+		t.Fatal("an empty key was accepted")
+	}
+	if _, err := s.RequestApproval("abcd1234", "", "claude", "agent", time.Minute); err == nil {
+		t.Fatal("an empty method was accepted")
+	}
+}
+
+func TestGovernanceUnknownKeyReadsAsAbsent(t *testing.T) {
+	s := mustOpen(t)
+	a, err := s.ApprovalForKey("deadbeef")
+	if err != nil {
+		t.Fatalf("ApprovalForKey: %v", err)
+	}
+	if a != nil {
+		t.Errorf("row = %+v, want nil for a key the store never saw", a)
+	}
+}
+
+func TestGovernanceEventsOrderedNewestLast(t *testing.T) {
+	s := mustOpen(t)
+	_, _ = s.RequestApproval("aaaa1111", "remember", "claude", "agent", time.Minute)
+	_, _ = s.RequestApproval("bbbb2222", "save_cap", "codex", "agent", time.Minute)
+	events, _ := s.GovernanceSnapshot()
+	if len(events) != 2 {
+		t.Fatalf("events = %d, want 2", len(events))
+	}
+	if events[0].ID >= events[1].ID {
+		t.Errorf("ids %d then %d: the trail is not ordered by insertion", events[0].ID, events[1].ID)
+	}
+	if events[1].Detail != "save_cap on agent" {
+		t.Errorf("detail = %q, want the method and surface", events[1].Detail)
+	}
+}
+
+func TestGovernanceEventsLimitTruncates(t *testing.T) {
+	s := mustOpen(t)
+	for _, key := range []string{"aaaa1111", "bbbb2222", "cccc3333"} {
+		_, _ = s.RequestApproval(key, "remember", "claude", "agent", time.Minute)
+	}
+	events, err := s.GovernanceEvents(2)
+	if err != nil {
+		t.Fatalf("GovernanceEvents(2): %v", err)
+	}
+	if len(events) != 2 {
+		t.Errorf("events = %d, want the first 2", len(events))
+	}
+}
+
+func TestGovernanceSurfaceDefaultsToAgent(t *testing.T) {
+	s := mustOpen(t)
+	if _, err := s.RequestApproval("abcd1234", "remember", "claude", "", time.Minute); err != nil {
+		t.Fatalf("RequestApproval: %v", err)
+	}
+	a, _ := s.ApprovalForKey("abcd1234")
+	if a.Surface != "agent" {
+		t.Errorf("surface = %q, want the agent default", a.Surface)
+	}
+}
+
+func TestGovernanceSnapshotMatchesTheTrail(t *testing.T) {
+	s := mustOpen(t)
+	_, _ = s.RequestApproval("aaaa1111", "remember", "claude", "agent", time.Minute)
+	if err := s.DecideApproval("aaaa1111", ApprovalAllow, "operator"); err != nil {
+		t.Fatalf("decide: %v", err)
+	}
+	snap, _ := s.GovernanceSnapshot()
+	trail, _ := s.GovernanceEvents(0)
+	if len(snap) != len(trail) {
+		t.Errorf("snapshot = %d events, trail = %d: they read the same rows", len(snap), len(trail))
+	}
+}
