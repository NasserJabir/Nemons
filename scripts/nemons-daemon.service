[Unit]
Description=Nemons Daemon — transparent coding agent orchestrator
Documentation=https://github.com/your-org/nemons
After=network.target

[Service]
Type=simple
User=%i
ExecStart=/usr/local/bin/npx nemons daemon start --config %h/.nemons/config/daemon.yml
ExecStop=/usr/local/bin/npx nemons daemon stop
Restart=on-failure
RestartSec=10
StandardOutput=append:%h/.nemons/logs/daemon.log
StandardError=append:%h/.nemons/logs/daemon-error.log
SyslogIdentifier=nemons-daemon

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.nemons
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true

# Resource limits
MemoryMax=2G
CPUQuota=200%
TasksMax=512

# Environment
Environment=NODE_ENV=production
Environment=NEMONS_HOME=%h/.nemons

[Install]
WantedBy=default.target
