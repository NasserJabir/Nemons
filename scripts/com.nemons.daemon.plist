<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nemons.daemon</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/npx</string>
        <string>nemons</string>
        <string>daemon</string>
        <string>start</string>
        <string>--config</string>
        <string>/Users/USERNAME/.nemons/config/daemon.yml</string>
    </array>
    
    <key>RunAtLoad</key>
    <true/>
    
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    
    <key>StandardOutPath</key>
    <string>/Users/USERNAME/.nemons/logs/daemon.log</string>
    
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/.nemons/logs/daemon-error.log</string>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>NODE_ENV</key>
        <string>production</string>
        <key>NEMONS_HOME</key>
        <string>/Users/USERNAME/.nemons</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>1024</integer>
    </dict>
</dict>
</plist>
