{
  "name": "@nemons/core",
  "version": "4.2.1",
  "description": "Nemos core runtime - TypeScript implementation of the Nemos operational intelligence layer (Stage 0-I + 10 research improvements + P2/P3 features)",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^3.23.2",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "homepage": "https://github.com/NasserJabir/Nemons",
  "repository": {
    "type": "git",
    "url": "https://github.com/NasserJabir/Nemons.git"
  },
  "bugs": {
    "url": "https://github.com/NasserJabir/Nemons/issues"
  }
}
